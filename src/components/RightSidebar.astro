---
import { Icon } from "astro-icon/components";
import YukinaConfig from "../../yukina.config";
import I18nKeys from "../locales/keys";
import { i18n } from "../locales/translation";
---

<div class="flex w-full flex-row justify-center">
  <div class="flex flex-col space-y-3">
    
    <!-- Recent Posts -->
    <div
      class="onload-animation rounded-3xl bg-[var(--card-color)] p-3"
      style="animation-delay: calc(var(--onload-animation-delay) + 4 * var(--onload-animation-interval));"
    >
      <div class="title m-[0.375rem]">
        <span class="pl-4 text-xl font-bold text-[var(--text-color)]">Recent Posts</span>
      </div>
      <div class="space-y-2">
        <!-- Add your recent posts logic here -->
        <p class="text-[var(--text-color-lighten)] text-sm px-3">Coming soon...</p>
      </div>
    </div>

    <!-- Archive -->
    <div
      class="onload-animation rounded-3xl bg-[var(--card-color)] p-3"
      style="animation-delay: calc(var(--onload-animation-delay) + 5 * var(--onload-animation-interval));"
    >
      <div class="title m-[0.375rem]">
        <span class="pl-4 text-xl font-bold text-[var(--text-color)]">Archive</span>
      </div>
      <div class="space-y-2">
        <!-- Add your archive logic here -->
        <p class="text-[var(--text-color-lighten)] text-sm px-3">Coming soon...</p>
      </div>
    </div>

    <!-- Custom Widget -->
    <div
      class="onload-animation rounded-3xl bg-[var(--card-color)] p-3"
      style="animation-delay: calc(var(--onload-animation-delay) + 6 * var(--onload-animation-interval));"
    >
      <div class="title m-[0.375rem]">
        <span class="pl-4 text-xl font-bold text-[var(--text-color)]">Widget</span>
      </div>
      <div class="p-3">
        <!-- Add any custom content here -->
        <p class="text-[var(--text-color-lighten)] text-sm">Coming soon...</p>
      </div>
    </div>

  </div>
</div>

<style>
  .title {
    display: flex;
    flex-direction: row;
    align-items: center;
    position: relative;
  }

  .title::before {
    position: absolute;
    display: block;
    content: " ";
    background-color: var(--primary-color);
    top: 3px;
    bottom: 3px;
    width: 0.3rem;
    border-radius: 4px;
  }
</style>